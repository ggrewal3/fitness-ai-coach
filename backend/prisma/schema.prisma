generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FitnessGoal {
  LOSE_FAT
  MAINTAIN
  GAIN_MUSCLE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum DietPreference {
  NO_PREFERENCE
  VEGETARIAN
  VEGAN
  PESCATARIAN
  HALAL
}

enum ActivitySource {
  MANUAL
  APPLE_HEALTH
  HEALTH_CONNECT
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  OTHER
}

enum NutritionSource {
  MANUAL
  AI_TEXT
  AI_PHOTO
}

enum TrainingType {
  STRENGTH
  CARDIO
  MOBILITY
  SPORT
  OTHER
}

model User {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile        FitnessProfile?
  weightCheckIns WeightCheckIn[]
  nutritionFoodItems NutritionFoodItem[]
  dailyActivities DailyActivity[]
  workoutSessions WorkoutSession[]
}

model FitnessProfile {
  id                Int             @id @default(autoincrement())
  userId            Int             @unique

  dateOfBirth       DateTime?
  heightCm          Float?
  targetWeightKg    Float?

  goal              FitnessGoal?
  activityLevel     ActivityLevel?
  dietPreference    DietPreference?

  medicalNotes      String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeightCheckIn {
  id         Int      @id @default(autoincrement())
  userId     Int
  weightKg   Float
  recordedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
}

model NutritionFoodItem {
  id           Int             @id @default(autoincrement())
  userId       Int
  foodName     String
  quantity     Float
  unit         String
  calories     Int
  proteinGrams Float
  carbsGrams   Float
  fatGrams     Float
  mealType     MealType
  source       NutritionSource @default(MANUAL)
  entryDate    DateTime        @db.Date
  recordedAt   DateTime
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entryDate])
  @@index([userId, recordedAt])
}

model DailyActivity {
  id                Int            @id @default(autoincrement())
  userId            Int
  activityDate      DateTime       @db.Date
  steps             Int
  walkingDistanceKm Float?
  activeCalories    Int?
  source            ActivitySource @default(MANUAL)
  recordedAt        DateTime
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityDate])
  @@index([userId, recordedAt])
}

model WorkoutSession {
  id              Int          @id @default(autoincrement())
  userId          Int
  trainingType    TrainingType
  durationMinutes Int
  notes           String?
  recordedAt      DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
}
