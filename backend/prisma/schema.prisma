generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FitnessGoal {
  LOSE_FAT
  MAINTAIN
  GAIN_MUSCLE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum DietPreference {
  NO_PREFERENCE
  VEGETARIAN
  VEGAN
  PESCATARIAN
  HALAL
}

enum ActivitySource {
  MANUAL
  APPLE_HEALTH
  HEALTH_CONNECT
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  OTHER
}

enum NutritionSource {
  MANUAL
  AI_TEXT
  AI_PHOTO
}

enum TrainingType {
  STRENGTH
  CARDIO
  MOBILITY
  SPORT
  OTHER
}

enum LoadUnit {
  KG
  LB
}

model User {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile        FitnessProfile?
  weightCheckIns WeightCheckIn[]
  nutritionFoodItems NutritionFoodItem[]
  dailyActivities DailyActivity[]
  workoutSessions WorkoutSession[]
  exercises       Exercise[]
}

model FitnessProfile {
  id                Int             @id @default(autoincrement())
  userId            Int             @unique

  dateOfBirth       DateTime?
  heightCm          Float?
  targetWeightKg    Float?

  goal              FitnessGoal?
  activityLevel     ActivityLevel?
  dietPreference    DietPreference?

  medicalNotes      String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeightCheckIn {
  id         Int      @id @default(autoincrement())
  userId     Int
  weightKg   Float
  recordedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
}

model NutritionFoodItem {
  id           Int             @id @default(autoincrement())
  userId       Int
  foodName     String
  quantity     Float
  unit         String
  calories     Int
  proteinGrams Float
  carbsGrams   Float
  fatGrams     Float
  mealType     MealType
  source       NutritionSource @default(MANUAL)
  entryDate    DateTime        @db.Date
  recordedAt   DateTime
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entryDate])
  @@index([userId, recordedAt])
}

model DailyActivity {
  id                Int            @id @default(autoincrement())
  userId            Int
  activityDate      DateTime       @db.Date
  steps             Int
  walkingDistanceKm Float?
  activeCalories    Int?
  source            ActivitySource @default(MANUAL)
  recordedAt        DateTime
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityDate])
  @@index([userId, recordedAt])
}

model WorkoutSession {
  id              Int          @id @default(autoincrement())
  userId          Int
  title           String
  // Logical training day chosen by the user, independent of recordedAt
  // (mirrors NutritionFoodItem.entryDate).
  workoutDate     DateTime     @db.Date
  trainingType    TrainingType
  durationMinutes Int
  notes           String?
  recordedAt      DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]

  @@index([userId, recordedAt])
  @@index([userId, workoutDate])
}

// userId = null  -> built-in FitAI exercise (seeded, identified by builtInKey)
// userId = X     -> private custom exercise owned by user X
model Exercise {
  id             Int      @id @default(autoincrement())
  userId         Int?
  builtInKey     String?  @unique
  name           String
  normalizedName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]

  @@unique([userId, normalizedName])
  @@index([normalizedName])
}

model WorkoutExercise {
  id               Int      @id @default(autoincrement())
  workoutSessionId Int
  exerciseId       Int
  // 0-based order within the session, assigned by the server.
  position         Int
  createdAt        DateTime @default(now())

  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  // NoAction (checked at end of statement) rather than Restrict, so deleting
  // a user can cascade through both their workouts and custom exercises.
  exercise       Exercise       @relation(fields: [exerciseId], references: [id], onDelete: NoAction)
  sets           WorkoutSet[]

  @@unique([workoutSessionId, position])
  @@index([exerciseId])
}

model WorkoutSet {
  id                Int       @id @default(autoincrement())
  workoutExerciseId Int
  // 0-based order within the exercise, assigned by the server.
  position          Int
  reps              Int
  // Stored exactly as entered in loadUnit; null means bodyweight.
  load              Decimal?  @db.Decimal(6, 2)
  loadUnit          LoadUnit?
  createdAt         DateTime  @default(now())

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutExerciseId, position])
}
