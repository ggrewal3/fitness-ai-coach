generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FitnessGoal {
  LOSE_FAT
  MAINTAIN
  GAIN_MUSCLE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum DietPreference {
  NO_PREFERENCE
  VEGETARIAN
  VEGAN
  PESCATARIAN
  HALAL
}

model User {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile      FitnessProfile?
}

model FitnessProfile {
  id                Int             @id @default(autoincrement())
  userId            Int             @unique

  dateOfBirth       DateTime?
  heightCm          Float?
  targetWeightKg    Float?

  goal              FitnessGoal?
  activityLevel     ActivityLevel?
  dietPreference    DietPreference?

  medicalNotes      String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}
